{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReqTracker",
  "version": "1.2.7",
  "identifier": "com.carlosgaubert.reqtracker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ReqTracker",
        "width": 1000,
        "height": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI1MjA2ODhCQzZDQjk4RTYKUldUbW1NdkdpMmdnSmZ2UnJ5UW1pWFpBMUtQOG1jV0g4Wmg4UHBhZnY1V0hVQ2pScVFXUWNWQ0gK",
      "endpoints": [
        "https://github.com/CarlosGaubert/ReqTracker/releases/latest/download/latest.json"
      ]
    }
  }
}
