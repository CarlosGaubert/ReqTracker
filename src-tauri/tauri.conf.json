{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tauri-app",
  "version": "1.2.3",
  "identifier": "com.carlosgaubert.tauri-app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "tauri-app",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "RWTmmMvGi2ggJfvRryQmiXZA1KP8mcWH8Zh8Ppafv5WHUCjRqQWQcVCH",
      "endpoints": [
        "https://github.com/CarlosGaubert/ReqTracker/releases/latest/download/latest.json"
      ]
    }
  }
}
